Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Color: 40; 40; 40
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: echo_li_odom

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /echo_li/odometry
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape:
        Value: Axes
        Axes Length: 0.25
        Axes Radius: 0.05
      Color: 255; 80; 80
      Keep: 1
      Covariance:
        Value: false
      Position Tolerance: 0.001
      Angle Tolerance: 0.01

    - Class: rviz_default_plugins/PointCloud2
      Name: Landmarks
      Enabled: true
      Topic:
        Value: /echo_li/landmarks
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (m): 0.02
      Style: Spheres
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: true
      Alpha: 1
      Decay Time: 0

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.02
      Frame Timeout: 5
      Frames:
        echo_li_odom:
          Value: true
        imu_link:
          Value: true

    - Class: rviz_default_plugins/Image
      Name: Image
      Enabled: true
      Topic:
        Value: /echo_li/image
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 255
      Min Value: 0
      Normalize Range: true

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: echo_li_odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: ThirdPersonFollower
      Value: ThirdPersonFollower
      Target Frame: imu_link
      Distance: 3.0
      Pitch: 0.5
      Yaw: 0.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  QMainWindow State: 
  Displays:
    collapsed: false
  Height: 900
  Width: 1600
  X: 100
  Y: 100
  Image:
    collapsed: false
  Views:
    collapsed: true
